{
  "id": "model-arena",
  "realm": "model-arena",
  "enabled": true,
  "displayName": "Model Evaluation Arena Realm",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to models and evaluations"
      },
      {
        "name": "analyst",
        "description": "Can upload models, create benchmarks, and run evaluations"
      },
      {
        "name": "admin",
        "description": "Full administrative permissions and audit access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "model-arena-client",
      "name": "Model Evaluation Arena Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "arena-client-secret-local-dev-only",
      "redirectUris": [
        "http://127.0.0.1:8000/api/auth/callback",
        "http://localhost:8000/api/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ],
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "enterprise-saml-idp",
      "displayName": "Enterprise SAML Identity Provider",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "entityId": "http://127.0.0.1:8080/realms/model-arena",
        "idpEntityId": "https://idp.example.com/saml/metadata",
        "singleSignOnServiceUrl": "https://idp.example.com/saml/sso",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "validateSignature": "true"
      }
    }
  ]
}
