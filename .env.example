# Application Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-this-in-production-random-secret-key-32-chars
COOKIE_SECURE=false

# Demo Mode (Localhost only; startup refuses demo mode in production)
DEMO_MODE=true

# OIDC / Keycloak Authentication
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/model-arena
OIDC_CLIENT_ID=model-arena-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
OIDC_FRONTEND_URL=http://127.0.0.1:5173

# Optional Advisory LLM Configuration (Keys only server-side, never logged)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://llm.chris-vo.com/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Database
DATABASE_URL=sqlite:///./arena.db
